  "components": [
    {
      "name": "Hot-Core Band",
      "kind": "nav",
      "refersTo": "band",
      "description": "Full-width hot-core header: single-cut mark and CRUCIBLE wordmark in iron, theme toggle right.",
      "html": "<header class=\"ds-band\"><a class=\"ds-brand\" href=\"#\"><svg viewBox=\"0 0 70 80\" aria-hidden=\"true\"><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M9 0H22V18H55Q65 18 65 28V34H70V47H65V70Q65 80 55 80H14Q4 80 4 70V49H0V35H4V26Q4 21 9 19Z M15 44H25Q23 36 38 26Q36 33 42 36Q47 38 46 44H55L49 65Q47 70 41 70H29Q22 70 20 64Z\"/></svg><span class=\"ds-word\">Crucible</span></a><button class=\"ds-toggle\" type=\"button\" aria-label=\"Switch light and dark\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"7.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M10 2.5a7.5 7.5 0 0 1 0 15z\" fill=\"currentColor\"/></svg></button></header>",
      "css": ".ds-band{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:60px;padding:0 1rem;background:#ff7738;color:#1a120c;border-bottom:1px solid rgb(0 0 0 / 22%)}.ds-brand{display:inline-flex;align-items:center;gap:.6rem;color:#1a120c;text-decoration:none}.ds-brand svg{width:26px;height:30px}.ds-word{font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:1.7rem;text-transform:uppercase;letter-spacing:.06em;line-height:1}.ds-toggle{display:inline-grid;place-items:center;width:40px;height:40px;padding:0;border-radius:4px;background:transparent;border:1px solid rgb(26 18 12 / 35%);color:#1a120c;cursor:pointer}.ds-toggle svg{width:20px;height:20px}.ds-toggle:hover{background:rgb(26 18 12 / 10%)}.ds-band :focus-visible{outline:2px solid #1a120c;outline-offset:3px;border-radius:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one hot-core action per step: Connect, then Install.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Connect</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:36px;padding:.4rem .95rem;border-radius:3px;border:1px solid #ff7738;background:#ff7738;color:#1a120c;font:inherit;font-weight:600;cursor:pointer}.ds-btn-primary:hover{background:#ff8a52;border-color:#ff8a52}.ds-btn-primary:active{background:#f0682b}.ds-btn-primary:focus-visible{outline:2px solid var(--focus,#ffc45d);outline-offset:3px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary actions in the action bar: Start Over, Report a Problem.",
      "html": "<button class=\"ds-btn-quiet\" type=\"button\">Start Over</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;min-height:36px;padding:.4rem .95rem;border-radius:3px;border:1px solid transparent;background:transparent;color:var(--muted,#b9aca0);font:inherit;font-weight:600;cursor:pointer}.ds-btn-quiet:hover{background:var(--surface-2,#2a231d);color:var(--text,#f2ece6)}.ds-btn-quiet:focus-visible{outline:2px solid var(--focus,#ffc45d);outline-offset:3px}"
    },
    {
      "name": "Plate",
      "kind": "card",
      "refersTo": "panel",
      "description": "Iron plate panel: square shoulders, full border, condensed uppercase h2.",
      "html": "<section class=\"ds-plate\"><h2>Update from a release</h2><p>Radio: Example radio. Runs now: 5f034440.</p></section>",
      "css": ".ds-plate{background:var(--surface,#1e1915);color:var(--text,#f2ece6);border:1px solid var(--border,#3d332b);border-radius:4px;padding:1.25rem;box-shadow:var(--shadow,0 1px 1px rgb(0 0 0 / 35%),0 6px 18px rgb(0 0 0 / 28%))}.ds-plate h2{margin:0 0 1rem;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:700;font-size:clamp(1.35rem,2.2vw,1.65rem);line-height:1.1;text-transform:uppercase;letter-spacing:.03em}.ds-plate p{margin:0}"
    },
    {
      "name": "Caution Notice",
      "kind": "custom",
      "refersTo": "notice-caution",
      "description": "Tinted plate with a full border, never a side bar; the standing stay-on-page line is a caution.",
      "html": "<p class=\"ds-notice\"><strong>Do not switch to another app while a radio transfer is active.</strong></p>",
      "css": ".ds-notice{margin:0;padding:.75rem 1rem;border-radius:3px;background:var(--warn-soft,#33270f);color:var(--text,#f2ece6);border:1px solid color-mix(in srgb,var(--warn,#f2bd57) 55%,transparent)}"
    },
    {
      "name": "Stepper",
      "kind": "nav",
      "refersTo": "stepper-step-current",
      "description": "Plates in a row; the current step is hot with a flame bottom edge, done steps carry a drawn check.",
      "html": "<ol class=\"ds-stepper\"><li class=\"ds-done\"><span class=\"ds-n\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/></svg></span>Update</li><li aria-current=\"step\"><span class=\"ds-n\">2</span>Install</li><li><span class=\"ds-n\">3</span>Verify</li></ol>",
      "css": ".ds-stepper{display:flex;gap:.5rem;list-style:none;margin:0;padding:0}.ds-stepper li{display:flex;align-items:center;gap:.5rem;padding:.25rem .75rem .25rem .25rem;border-radius:3px;background:var(--surface,#1e1915);border:1px solid var(--border,#3d332b);color:var(--muted,#b9aca0);font-size:.875rem;font-weight:600}.ds-n{display:inline-grid;place-items:center;min-width:1.4rem;height:1.4rem;border-radius:2px;background:var(--surface-2,#2a231d);font-variant-numeric:tabular-nums}.ds-n svg{width:.85rem;height:.85rem}.ds-done .ds-n{color:var(--ok,#86d6a0)}.ds-stepper li[aria-current]{color:var(--text,#f2ece6);border-color:#ff7738;box-shadow:inset 0 -2px 0 #ffc45d}.ds-stepper li[aria-current] .ds-n{background:#ff7738;color:#1a120c}"
    },
    {
      "name": "Release Row",
      "kind": "custom",
      "refersTo": "release-row-picked",
      "description": "A release plate; the picked row takes the hot-core border, ember tint and flame bottom edge.",
      "html": "<label class=\"ds-release ds-picked\"><input type=\"radio\" checked name=\"r\"><b>crucible-c617b8b4-261126-3</b><span class=\"ds-tag\">Test build</span></label>",
      "css": ".ds-release{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.75rem;padding:.75rem;border:1px solid var(--border,#3d332b);border-radius:3px;background:var(--surface,#1e1915);color:var(--text,#f2ece6);cursor:pointer}.ds-release input{margin:0;accent-color:#ff7738}.ds-release b{font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:.95em;font-variant-numeric:tabular-nums}.ds-picked{border-color:#ff7738;background:var(--accent-soft,#3a1f12);box-shadow:inset 0 -2px 0 #ffc45d}.ds-tag{font-size:.72rem;font-weight:700;padding:.1rem .5rem;border-radius:3px;background:var(--warn-soft,#33270f);color:var(--warn,#f2bd57)}"
    },
    {
      "name": "The Pour",
      "kind": "custom",
      "refersTo": "pour",
      "description": "Signature progress bar: molten fill cooling behind a pulsing flame edge in an iron mould; sets without flame when stopped.",
      "html": "<div class=\"ds-pour ds-active\" role=\"progressbar\" aria-valuenow=\"62\" aria-valuemin=\"0\" aria-valuemax=\"100\"><span style=\"width:62%\"></span></div>",
      "css": ".ds-pour{width:100%;height:14px;border-radius:2px;background:#2a231d;box-shadow:inset 0 1px 2px rgb(0 0 0 / 45%);overflow:hidden}.ds-pour>span{position:relative;display:block;height:100%;border-radius:2px;background:linear-gradient(90deg,#9c3410,#ff7738);transition:width .4s cubic-bezier(.16,1,.3,1)}.ds-pour.ds-active>span{background:linear-gradient(90deg,#9c3410 0%,#c84a13 40%,#ff7738 82%,#ffc45d 100%)}.ds-pour.ds-active>span::after{content:'';position:absolute;top:0;right:0;bottom:0;width:10px;background:#ffc45d;animation:ds-melt 1.1s ease-in-out infinite alternate}@keyframes ds-melt{from{opacity:1}to{opacity:.35}}@media (prefers-reduced-motion:reduce){.ds-pour>span{transition:none}.ds-pour.ds-active>span::after{animation:none;opacity:1}}"
    }
  ],
  "narrative": {
    "northStar": "The Single Pour",
    "overview": "Updating a radio is one heat, one casting, watched until it sets. The page is cast iron and molten metal. Hot-core orange is the committed shell color: a full-width band at the top carrying the single-cut mark and the CRUCIBLE wordmark in iron. Flame marks only the live edge. Everything else is iron plate on an iron-black ground (dark) or greensand grey (light).\n\nDensity is operational: one column, one flasher plate, a stepper, one primary action. Headings are condensed uppercase, like letters cast into iron. Reading text stays in the system sans. Mono appears only for versions, hashes and the build stamp.\n\nThe page refuses the grey installer wizard with a blue accent. Light mode refuses cream: its ground is moulding sand, grey with a green cast.",
    "keyCharacteristics": [
      "Hot-core band across the top; the mark and wordmark in iron.",
      "Condensed uppercase casting-mark headings (Barlow Condensed 700).",
      "Plates with square shoulders (3-4px), full borders, no side bars.",
      "Flame appears only at a live edge: the pour's leading edge, focus, the current step, the picked release.",
      "Every progress bar is a pour that cools behind its edge and sets when it stops.",
      "Dark is the default; light follows the system setting unless the visitor picked dark."
    ],
    "rules": [
      {
        "name": "The Live Edge Rule",
        "body": "Flame marks only something live or chosen right now: the pour's leading edge, focus, the current step, the picked release. It never fills an area and never decorates a static element.",
        "section": "colors"
      },
      {
        "name": "The Greensand Rule",
        "body": "The light ground is grey with a green cast (greensand). No cream, beige or warm off-white.",
        "section": "colors"
      },
      {
        "name": "The Brand Pair Rule",
        "body": "Hot-core and flame are the only brand hues. Upstream's RadioFoundry accent never appears.",
        "section": "colors"
      },
      {
        "name": "The Casting Mark Rule",
        "body": "Only h1, h2 and the wordmark use the condensed face, always uppercase. Body, labels and h3 stay in the system sans.",
        "section": "typography"
      },
      {
        "name": "The Machine Text Rule",
        "body": "Mono is for strings a machine wrote (release names, hashes, the build stamp). Numerals in mono, code and the stamp are tabular.",
        "section": "typography"
      },
      {
        "name": "The Bottom Edge Rule",
        "body": "A chosen or current item takes a 2px flame bottom edge, drawn inset. Never a side stripe.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put hot-core only where the brand speaks or the user acts: band, primary button, current step, pour.",
      "Do keep flame on a live edge only (The Live Edge Rule).",
      "Do mark the current or chosen item with a 2px inset flame bottom edge.",
      "Do keep every plate square-shouldered (2-4px) with a full 1px border.",
      "Do set h1, h2 and the wordmark in Barlow Condensed 700, uppercase.",
      "Do keep the pour's mould iron (#2a231d) in both themes and drop the flame when the pour stops.",
      "Do keep all text WCAG AA in both themes; on sand, use rust instead of flame for focus.",
      "Do restyle upstream classes from crucible.css; leave the flasher's markup and flow upstream's."
    ],
    "donts": [
      "Don't use side-stripe borders (border-left accents) on notices, rows or panels.",
      "Don't use cream, beige or warm off-white for the light ground.",
      "Don't use pills (999px) or soft 7-10px corners.",
      "Don't use the condensed face for body text, labels or h3.",
      "Don't tone a standing caution as an error.",
      "Don't use RadioFoundry's accent colors or name RadioFoundry as the product.",
      "Don't add eyebrows or kickers above headings."
    ]
  }
}
